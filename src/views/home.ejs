        </a>
        <a href="#" aria-label="Discord" title="Add your link">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 5.4A17.6 17.6 0 0 0 15.9 4l-.22.4a12.5 12.5 0 0 1 3.9 1.6 15.9 15.9 0 0 0-15.15 0 12.5 12.5 0 0 1 3.9-1.6L8.1 4a17.6 17.6 0 0 0-4.4 1.4C1.4 9.1.7 12.7 1.02 16.2a17.7 17.7 0 0 0 5.35 2.7l.7-1.14a11.4 11.4 0 0 1-1.8-.87c.15-.11.3-.23.44-.35a12.6 12.6 0 0 0 10.6 0c.14.12.29.24.44.35-.57.34-1.17.63-1.8.87l.7 1.14a17.6 17.6 0 0 0 5.35-2.7c.4-4.06-.67-7.62-2.7-10.8zM8.68 14.1c-.9 0-1.63-.83-1.63-1.85s.72-1.85 1.63-1.85 1.65.84 1.63 1.85c0 1.02-.72 1.85-1.63 1.85zm6.64 0c-.9 0-1.63-.83-1.63-1.85s.72-1.85 1.63-1.85 1.65.84 1.63 1.85c0 1.02-.72 1.85-1.63 1.85z"/></svg>
