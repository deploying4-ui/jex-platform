<script>
  (function () {
    var toggle = document.getElementById('homeNavToggle');
    var menu = document.getElementById('homeMobileMenu');
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // Animated counters (real numbers rendered server-side via data-target)
    function animateCounter(el, duration) {
      var target = Number(el.getAttribute('data-target')) || 0;
      var start = 0;
      var t0 = null;
      function step(ts) {
        if (!t0) t0 = ts;
        var progress = Math.min((ts - t0) / duration, 1);
        el.textContent = Math.floor(start + (target - start) * progress).toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    document.querySelectorAll('.home-hero-stats .value').forEach(function (el) {
      animateCounter(el, 1200);
    });

    // Rotating bot name in the headline, cycling through the real catalog.
    var botNames = [<% bots.forEach(function(bot, i) { %><%= i > 0 ? ',' : '' %><%- JSON.stringify(bot.name) %><% }) %>];
    if (!botNames.length) botNames = ['<%= siteName %>'];
    var rotateEl = document.getElementById('heroRotate');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (rotateEl && botNames.length > 1 && !reduceMotion) {
      var idx = 0;
      setInterval(function () {
        idx = (idx + 1) % botNames.length;
        rotateEl.style.opacity = 0;
        setTimeout(function () {
          rotateEl.textContent = botNames[idx];
          rotateEl.style.opacity = 1;
        }, 220);
      }, 2400);
    }
  })();
</script>
