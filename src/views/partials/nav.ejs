<div class="topbar">
  <div class="brand"><span class="brand-mark">&gt;_</span><%= siteName %><span class="dot">.</span></div>
  <div class="corner-menu" id="cornerMenu">
    <button class="dots-btn" id="dotsBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Menu">
      <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 6H17M3 10H17M3 14H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <div class="corner-dropdown" id="cornerDropdown">
      <a class="corner-link" href="/dashboard">Dashboard</a>
      <a class="corner-link" href="/deploy">Deploy Bot</a>
      <a class="corner-link" href="/my-bots">My Bots</a>
      <a class="corner-link" href="/my-coins">My Coins</a>
      <a class="corner-link" href="/topup">Buy Coins</a>
      <a class="corner-link" href="/my-profile">My Profile</a>
      <a class="corner-link" href="<%= whatsappSupportUrl %>" target="_blank" rel="noopener">Support</a>
      <% if (tutorialUrl) { %><a class="corner-link" href="<%= tutorialUrl %>" target="_blank" rel="noopener">Deploy Tutorial</a><% } %>
      <% if (user.is_admin) { %><a class="corner-link" href="/admin">Admin</a><% } %>
      <div class="corner-divider"></div>
      <form method="POST" action="/logout">
        <button type="submit" class="corner-link corner-link-btn">Sign out</button>
      </form>
    </div>
  </div>
</div>
<script>
  (function () {
    var menu = document.getElementById('cornerMenu');
    var btn = document.getElementById('dotsBtn');
    if (!menu || !btn) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target)) {
        menu.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
