<%- include('partials/head') %>
<a href="/" class="back-link">&larr; Back to home</a>

<div class="auth-wrap">
  <div style="width:100%;max-width:400px">
    <div class="auth-brand-row">
      <a href="/" class="brand"><span class="brand-mark">&gt;_</span><%= siteName %><span class="dot">.</span></a>
    </div>

    <div class="auth-card">
      <h1>Create an account</h1>
      <p class="auth-sub">Free to join — you'll start with coins already in your balance.</p>

      <% if (ref) { %>
      <div class="ref-banner">You were invited by a friend — you'll both get bonus coins.</div>
      <% } %>

      <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>"><%= flash.message %></div>
      <% } %>

      <form method="POST" action="/register" id="registerForm">
        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required autofocus>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="field-relative">
            <input type="password" id="password" name="password" placeholder="At least 8 characters" minlength="8" required>
            <button type="button" class="field-inline-btn" id="togglePassword">Show</button>
          </div>
          <div class="strength-track"><div class="strength-fill" id="strengthFill"></div></div>
          <div class="strength-label" id="strengthLabel">Password strength</div>
        </div>

        <div class="field">
          <label for="confirmPassword">Confirm password</label>
          <div class="field-relative">
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat your password" minlength="8" required>
            <button type="button" class="field-inline-btn" id="toggleConfirmPassword">Show</button>
          </div>
          <div class="match-hint" id="matchHint"></div>
        </div>

        <div class="field">
          <label for="referralCode">Referral code <span style="color:var(--text-faint);font-weight:400">(optional)</span></label>
          <input type="text" id="referralCode" name="ref" placeholder="e.g. ABC123" value="<%= ref %>">
        </div>

        <div class="checkbox-row">
          <input type="checkbox" id="terms" required>
          <label for="terms">I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a></label>
        </div>

        <button type="submit" class="btn btn-primary" id="registerBtn">Create my account</button>
      </form>

      <% if (googleEnabled || githubEnabled) { %>
      <div class="auth-divider"><span>or</span></div>
      <% } %>

      <% if (googleEnabled) { %>
      <a href="/auth/google<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn-google">
        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
          <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.85.86-3.04.86-2.34 0-4.32-1.58-5.03-3.71H.96v2.33A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.97 10.71A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.17.29-1.71V4.96H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3.01-2.33z"/>
          <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.96l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
        </svg>
        Continue with Google
      </a>
      <% } %>

      <% if (githubEnabled) { %>
      <a href="/auth/github<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn-oauth">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Continue with GitHub
      </a>
      <% } %>

      <div class="auth-foot">
        <p>Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>
</div>

<script>
  function wireToggle(btnId, inputId) {
    document.getElementById(btnId).addEventListener('click', function () {
      var input = document.getElementById(inputId);
      var isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      this.textContent = isHidden ? 'Hide' : 'Show';
    });
  }
  wireToggle('togglePassword', 'password');
  wireToggle('toggleConfirmPassword', 'confirmPassword');

  var strengthColors = ['var(--danger)', 'var(--danger)', 'var(--warn)', 'var(--success)', 'var(--success)'];
  var strengthLabels = ['Very weak', 'Weak', 'Medium', 'Strong', 'Very strong'];

  function checkStrength() {
    var v = document.getElementById('password').value;
    var score = 0;
    if (v.length >= 8) score++;
    if (/[A-Z]/.test(v)) score++;
    if (/[0-9]/.test(v)) score++;
    if (/[^A-Za-z0-9]/.test(v)) score++;
    var fill = document.getElementById('strengthFill');
    var label = document.getElementById('strengthLabel');
    fill.style.width = (v.length ? (score * 25) : 0) + '%';
    fill.style.background = strengthColors[score];
    label.textContent = v.length ? strengthLabels[score] : 'Password strength';
  }

  function checkMatch() {
    var pw = document.getElementById('password').value;
    var cpw = document.getElementById('confirmPassword').value;
    var hint = document.getElementById('matchHint');
    if (!cpw) { hint.textContent = ''; hint.className = 'match-hint'; return; }
    if (pw === cpw) { hint.textContent = 'Passwords match'; hint.className = 'match-hint ok'; }
    else { hint.textContent = 'Passwords do not match'; hint.className = 'match-hint bad'; }
  }

  document.getElementById('password').addEventListener('input', function () { checkStrength(); checkMatch(); });
  document.getElementById('confirmPassword').addEventListener('input', checkMatch);

  // Stops a slow response from looking like "nothing happened" and
  // being met with more clicks — each of which was quietly stacking up
  // against the rate limit on the server.
  document.getElementById('registerForm').addEventListener('submit', function () {
    var btn = document.getElementById('registerBtn');
    btn.disabled = true;
    btn.textContent = 'Creating account…';
  });
</script>
<%- include('partials/foot') %>
