# ── Server ──────────────────────────────────────────────
PORT=3000
# Long random string — used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string
# Public URL this app is served from (no trailing slash) — also used to
# build referral links, so keep it accurate once you're live.
BASE_URL=http://localhost:3000

# ── Branding ────────────────────────────────────────────
SITE_NAME=Bot Deploy
TEAM_NAME=Bot Deploy

# ── Heroku Platform API ─────────────────────────────────
# Account Settings -> API Key, on the Heroku account that will own the
# deployed bots.
HEROKU_API_KEY=

# ── Outgoing email (verification codes) ─────────────────
# Any SMTP provider works (Gmail app password, Brevo, Resend, Zoho, etc).
# If left blank, the platform runs in dev mode: codes are printed to the
# server console instead of emailed, so you can test the full flow first.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bot Deploy <no-reply@example.com>"

# ── Admin account ────────────────────────────────────────
# Seeded automatically the first time the server starts. If this email
# already has an account, it's just promoted to admin — its existing
# password is left alone.
ADMIN_EMAIL=devkelvin903@gmail.com
ADMIN_PASSWORD=kelvin##??256

# ── Coin economy (JC = Jexploit Coins) ──────────────────
STARTER_COINS=2
REFERRAL_BONUS_COINS=5
MAX_BOTS_PER_USER=50

# ── Payments ─────────────────────────────────────────────
# There's no payment gateway wired up — this is a manual flow: users pay
# to the number below, email proof, and an admin credits their JC via
# the /admin panel (see README).
PAYMENT_METHOD_LABEL=Mobile Money
PAYMENT_NUMBER=+256742932677
SUPPORT_EMAIL=techkevin93@gmail.com

# ── Optional ─────────────────────────────────────────────
# Link shown on the deploy page pointing at your own session-pairing
# site, if you have one. Leave blank to hide the link.
SESSION_HELPER_URL=https://xploitdevkevin-pairing-site.onrender.com/
