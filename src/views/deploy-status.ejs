<%- include('partials/head') %>
<div class="dashboard-container">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <div class="page-header">
      <div class="page-header-left">
        <h1>Deploy status</h1>
      </div>
      <div class="page-header-actions">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">☰</button>
      </div>
    </div>

    <div class="status-hero" id="statusHero">
      <div class="spinner" id="statusSpinner"></div>
      <div>
        <h2 style="margin-bottom:2px" id="statusHeading">Deploying <%= bot ? bot.name : deployment.bot_slug %></h2>
        <p style="margin:0" id="statusSub"><span class="mono"><%= deployment.app_name %></span></p>
      </div>
    </div>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
    <% } %>

    <div class="console" id="console">
      <div class="console-line"><span class="t">[00:00]</span><span class="msg">Deploy started (id: <%= deployment.heroku_app_setup_id || 'n/a' %>)</span></div>
      <div class="console-line"><span class="t">[00:01]</span><span class="msg">Building <%= deployment.app_name %><span class="console-cursor"></span></span></div>
    </div>

    <div id="statusActions" style="margin-top:20px;display:none" class="btn-row"></div>

    <div style="margin-top:28px">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px">
        <span class="panel-title" style="margin:0">Live app logs</span>
        <span class="badge badge-pending" id="logStatusBadge">Connecting…</span>
        <div class="btn-row" style="flex:0 0 auto">
          <button class="btn btn-ghost" id="pauseBtn" type="button" style="min-width:auto;width:auto;padding:6px 12px">Pause</button>
          <button class="btn btn-ghost" id="clearBtn" type="button" style="min-width:auto;width:auto;padding:6px 12px">Clear</button>
          <button class="btn btn-ghost" id="downloadBtn" type="button" style="min-width:auto;width:auto;padding:6px 12px">Download</button>
        </div>
      </div>
      <p style="margin:0 0 10px;font-size:12px;color:var(--text-faint)">Starts streaming as soon as the dyno is up — nothing to show while it's still building.</p>
      <div class="console" id="logConsole" style="max-height:280px">
        <div class="console-line"><span class="t">·</span><span class="msg">Waiting for the app to come up<span class="console-cursor"></span></span></div>
      </div>
    </div>

    <div class="panel" id="redeployPanel" style="margin-top:20px;<%= deployment.status === 'succeeded' ? '' : 'display:none' %>">
      <div class="panel-title">Update session ID</div>
      <p style="margin-bottom:14px">Session expired or changed? Update it here — the app restarts with the new value, no new deploy and no extra JC.</p>
      <form method="POST" action="/deploy/status/<%= deployment.id %>/redeploy">
        <div class="field">
          <label for="session_id">New SESSION_ID</label>
          <input type="text" id="session_id" name="session_id" class="mono-field" placeholder="Paste the new session string" required>
        </div>
        <button type="submit" class="btn btn-primary">Update &amp; restart</button>
      </form>
    </div>

    <a href="/my-bots" class="btn btn-secondary" style="max-width:200px">Manage in My Bots</a>
  </div>
</div>
<script>
  window.DEPLOYMENT_ID = <%= deployment.id %>;
  window.LOG_DEPLOYMENT_ID = <%= deployment.id %>;
  window.LOG_TOKEN = <%= JSON.stringify(logToken) %>;
</script>
<script src="/js/deploy-status.js"></script>
<script src="/js/bot-logs.js"></script>
<%- include('partials/foot') %>
