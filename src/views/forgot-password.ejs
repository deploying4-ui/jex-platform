<%- include('partials/head') %>
<a href="/login" class="back-link">&larr; Back to log in</a>

<div class="auth-wrap">
  <div style="width:100%;max-width:380px">
    <div class="auth-brand-row">
      <a href="/" class="brand"><span class="brand-mark">&gt;_</span><%= siteName %><span class="dot">.</span></a>
    </div>

    <div class="auth-card">
      <h1>Reset your password</h1>
      <p class="auth-sub" id="stepHint">Enter your account email and we'll send you a code.</p>

      <div id="formMessage"></div>

      <!-- Step 1: email -->
      <div id="step1">
        <div class="field">
          <label for="email">Account email</label>
          <input type="email" id="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <button class="btn btn-primary" id="sendBtn">Send code</button>
      </div>

      <!-- Step 2: code -->
      <div id="step2" style="display:none">
        <div class="field otp-row">
          <label for="code">6-digit code</label>
          <input type="text" id="code" class="otp-input" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code">
        </div>
        <button class="btn btn-primary" id="verifyBtn">Verify code</button>
        <p class="auth-foot" style="margin-top:14px"><a href="#" id="changeEmail">Use a different email</a></p>
      </div>

      <!-- Step 3: new password -->
      <div id="step3" style="display:none">
        <div class="field">
          <label for="newPassword">New password</label>
          <input type="password" id="newPassword" placeholder="6 characters minimum" required>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" placeholder="Repeat your new password" required>
        </div>
        <button class="btn btn-primary" id="resetBtn">Reset password</button>
      </div>

      <div class="auth-foot" style="margin-top:22px">
        <p><a href="/login">Log in</a> &middot; <a href="/register">Create an account</a></p>
      </div>
    </div>
  </div>
</div>

<script>
  var currentEmail = '';

  function showMessage(text, type) {
    var box = document.getElementById('formMessage');
    box.innerHTML = '<div class="alert alert-' + (type === 'error' ? 'error' : 'success') + '">' + text + '</div>';
    setTimeout(function () { box.innerHTML = ''; }, 6000);
  }

  function showStep(n) {
    document.getElementById('step1').style.display = n === 1 ? 'block' : 'none';
    document.getElementById('step2').style.display = n === 2 ? 'block' : 'none';
    document.getElementById('step3').style.display = n === 3 ? 'block' : 'none';
    var hint = document.getElementById('stepHint');
    if (n === 1) hint.textContent = "Enter your account email and we'll send you a code.";
    if (n === 2) hint.textContent = 'Enter the 6-digit code we emailed you.';
    if (n === 3) hint.textContent = 'Choose a new password for your account.';
    if (n === 2) setTimeout(function () { document.getElementById('code').focus(); }, 50);
  }

  function setLoading(btn, loading, idleText) {
    btn.disabled = loading;
    btn.innerHTML = loading ? '<span class="spinner-inline"></span>Working…' : idleText;
  }

  document.getElementById('sendBtn').addEventListener('click', async function () {
    var email = document.getElementById('email').value.trim();
    if (!email || !/^\S+@\S+\.\S+$/.test(email)) return showMessage('Enter a valid email address', 'error');
    var btn = this;
    setLoading(btn, true, 'Send code');
    try {
      await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      });
      currentEmail = email;
      showMessage('Code sent — check your email (and spam folder).', 'success');
      setTimeout(function () { showStep(2); }, 1000);
    } catch (err) {
      showMessage('Network error, please try again.', 'error');
    } finally {
      setLoading(btn, false, 'Send code');
    }
  });

  document.getElementById('verifyBtn').addEventListener('click', async function () {
    var code = document.getElementById('code').value.trim();
    if (!/^\d{6}$/.test(code)) return showMessage('Enter the 6-digit code', 'error');
    var btn = this;
    setLoading(btn, true, 'Verify code');
    try {
      var res = await fetch('/api/auth/verify-reset-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: currentEmail, code: code })
      });
      var data = await res.json();
      if (res.ok && data.valid) {
        showMessage('Code valid.', 'success');
        setTimeout(function () { showStep(3); }, 600);
      } else {
        showMessage(data.error || 'Incorrect or expired code', 'error');
      }
    } catch (err) {
      showMessage('Connection error', 'error');
    } finally {
      setLoading(btn, false, 'Verify code');
    }
  });

  document.getElementById('resetBtn').addEventListener('click', async function () {
    var newPass = document.getElementById('newPassword').value;
    var confirmPass = document.getElementById('confirmPassword').value;
    var code = document.getElementById('code').value.trim();
    if (newPass.length < 6) return showMessage('6 characters minimum', 'error');
    if (newPass !== confirmPass) return showMessage('Passwords do not match', 'error');
    var btn = this;
    setLoading(btn, true, 'Reset password');
    try {
      var res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: currentEmail, code: code, password: newPass })
      });
      var data = await res.json();
      if (res.ok) {
        showMessage('Password changed — redirecting…', 'success');
        setTimeout(function () { location.href = '/login'; }, 1800);
      } else {
        showMessage(data.error || 'Could not reset your password', 'error');
      }
    } catch (err) {
      showMessage('Network error', 'error');
    } finally {
      setLoading(btn, false, 'Reset password');
    }
  });

  document.getElementById('changeEmail').addEventListener('click', function (e) {
    e.preventDefault();
    showStep(1);
  });

  document.getElementById('code').addEventListener('input', function (e) {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 6);
  });

  document.getElementById('email').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') document.getElementById('sendBtn').click();
  });
</script>
<%- include('partials/foot') %>
